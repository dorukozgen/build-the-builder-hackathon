             """Writes tests/BRIEF.fixtures.json, tests/BRIEF.cases.json and tools/openapi-BRIEF.json from the case folder's sources.
             
                 python tests/gen_cases_BRIEF.py <case folder> <mock base url>
             """
             import json, pathlib, sys
             
             ROOT = pathlib.Path(__file__).resolve().parent.parent
             folder = pathlib.Path(sys.argv[1])
             mock = sys.argv[2].rstrip("/")
             data = json.load(open(folder / "test-environment" / "test-customers.json", encoding="utf-8"))
             NOW = "2026-10-12T10:30:00+03:00"
             
             fx = []
             for c in data["customers"]:
                 cl = c["services"]["cards.list"]["response"].get("data") or {}
                 cards = ", ".join(f"{(k.get('productName') or '(adı boş)')} (sonu {k['cardNumberLast4']})" for k in cl.get("cards", []))
                 em = (c["services"]["contact.email.get"]["response"].get("data") or {}).get("ibanEmail") or "kayıtlı e-posta yok"
                 fx.append({"id": c["customerNo"], "brief": "BRIEF", "variables": {"customerNumber": c["customerNo"], "now": NOW}, "identity": {},
                            "persona": f"{c['firstName']} {c['lastName']}, Freya Bank müşterisi, kredi kartı ekstre borcunu öğrenmek için aradı. Kartları: {cards or 'bilmiyor'}. E-posta: {em}.",
                            "language": "tr"})
             (ROOT / "tests" / "BRIEF.fixtures.json").write_text(json.dumps(fx, ensure_ascii=False, indent=1), encoding="utf-8")
             
             F = "BRIEF.facts:"
             cases = []
             
             
             def add(fixture, title, family, level, rules, script, checks, forbidden=(), style=None, third=False):
                 c = {"id": "GEN-%02d" % (len(cases) + 1), "fixture": fixture, "title": title, "family": family, "level": level,
                      "rules": [F + str(r) for r in rules], "script": script, "expected": {}, "checks": checks, "forbidden_tools": list(forbidden)}
                 if style:
                     c["style"] = style
                 if third:
                     c["third_party"] = True
                 cases.append(c)
             
             
             W = ["statement.week.change"]
             P = ["statement.pdf.send"]
             # ---- happy reading
             add("95004361", "Single card, paid below the minimum, thanks and ends", "Happy path", "easy", [3, 12, 13, 16, 18, 20, 28],
                 "Listens to the debt reading. When offered further transactions, says 'Teşekkürler, bu kadar.'",
                 ["the agent does not ask which card", "the reading starts with the last four digits 2000 and the card name Yıldız Premium and the statement date 5 Ekim 2026",
                  "Turkish Lira: statement debt 12.000, minimum 4.800, remaining total debt 9.500, remaining minimum 2.000 are all said",
                  "Euro debt 85,20 and minimum 34,10 are said; Dolar and İngiliz Sterlini with no debt are said together in one sentence",
                  "the due date 15 Ekim 2026 is said", "after the thanks the agent says 'Sizi ana menüye yönlendiriyorum' and does not repeat the offer"], W + P)
             add("96158684", "Minimum paid: thanks for the minimum payment", "Happy path", "easy", [15, 18, 20],
                 "Listens to the debt. Then says 'Tamam sağ olun, başka bir şey yok.'",
                 ["the agent says the Turkish Lira debt 10.000 and remaining total debt 5.000 and thanks for the minimum payment",
                  "the agent does not mention İngiliz Sterlini (the card has no such block) in the no-debt sentence, or mentions only Dolar and Euro as having no debt",
                  "the due date 19 Ekim 2026 is said"], W + P)
             add("92460108", "TL nothing paid plus Dolar and Euro debt", "Happy path", "easy", [14, 17, 21, 12],
                 "Listens to the debt, then says goodbye.",
                 ["Turkish Lira debt 18.500 and minimum 7.400 are said", "Dolar debt 650 with minimum 260 is said, then Euro debt 380 with minimum 152",
                  "currencies are said by name (Dolar, Euro), never as USD or EUR codes", "İngiliz Sterlini is said to have no debt", "due date 15 Ekim 2026"], W + P)
             add("94896459", "Debt in all four currencies with kuruş", "Amounts", "medium", [17, 18, 22, 21],
                 "Listens to the whole reading, then says thanks and goodbye.",
                 ["Turkish Lira debt 14.250,35 with minimum 5.700,14 is said with the kuruş", "Dolar 812,45 (minimum 324,98), Euro 563,20 (minimum 225,28) and İngiliz Sterlini 347,85 (minimum 139,14) are said",
                  "no sentence says some currency has no debt", "no amount is rounded"], W + P)
             add("97974112", "Large amounts with kuruş on Yıldız Premium", "Amounts", "medium", [4, 16, 22],
                 "When asked which card, says 'Yıldız Premium'. Listens, says it does not want another card, then nothing else.",
                 ["the card question gives at most two example card names, both from the caller's own cards", "Turkish Lira debt 128.450,75, minimum 51.380,30, remaining total 96.200,75, remaining minimum 19.130,30 are said exactly",
                  "due date 19 Ekim 2026"], W + P)
             add("92122831", "TL paid in full, only foreign debt read", "Amounts", "medium", [17, 18, 24],
                 "Listens, then says that's all.",
                 ["Dolar debt 120 (minimum 48) and Euro debt 240,50 (minimum 96,20) are said", "Turkish Lira is said to have no debt; no Turkish Lira debt amount is read as owed"], W + P)
             add("92311921", "No statement debt, credit balance", "Edge", "medium", [19, 24],
