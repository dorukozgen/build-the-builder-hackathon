               462	def api_tool(base, name, desc, props, required, pre="", post="", timeout=12000):
               463	    body = {"customer_id": {"type": "string", "default": "{{customer_id}}"}}
               464	    body.update(props)
               465	    t = {"type": "function", "config": {"timeoutMs": timeout, "maxRetries": 0},
               466	         "function": {"name": name, "handler": "__function__:api_call", "description": desc,
               467	                      "parameters": {"type": "object", "properties": {
               468	                          "url": {"type": "string", "default": base + "/" + name},
               469	                          "method": {"type": "string", "default": "POST"},
               470	                          "headers": {"type": "object", "properties": {"Content-Type": {"type": "string", "default": "application/json"}}},
               471	                          "body": {"type": "object", "properties": body, "required": required}}}}}
               472	    if pre:
               473	        t["pre_process_code"] = pre
               474	    if post:
               475	        t["post_process_code"] = post
               476	    return t
               477	
               478	
               479	def grp(*conds):
               480	    return {"logic": "or", "conditions": list(conds)}
               481	
               482	
               483	def c(var, op, val=None):
               484	    d = {"variable": var, "operator": op}
               485	    if val is not None:
               486	        d["operand"] = val
               487	    return d
               488	
               489	
               490	def tr(target, desc, cond, tool=False):
               491	    t = {"target_node": target, "description": desc, "condition": cond}
               492	    if tool:
               493	        t["is_tool_call"] = True
               494	    return t
               495	
               496	
               497	def code_node(name, code, nxt):
               498	    return {"name": name, "node_type": "code", "passthrough": True, "passthrough_default_transition": nxt,
               499	            "on_enter": {"type": "silent"}, "disable_inactivity_monitor": True,
               500	            "pre_actions": [{"type": "function", "function": {"name": "code_exec", "handler": "__function__:code_exec",
               501	                                                               "parameters": {"type": "object", "properties": {
               502	                                                                   "code": {"type": "string", "default": code},
               503	                                                                   "timeout_ms": {"type": "number", "default": 10000}}}}}],
               504	            "transitions": [tr(nxt, "always", {"operator": "always"})]}
               505	
               506	
               507	CLOSE_TOOLS = [
               508	    ("close_unsupported", "unsupported", "CALL this to end the call when the customer asked for an application type the assistant cannot take and declined the transfer to the applications team. Say nothing yourself before it: the closing sentence is spoken for you."),
               509	    ("close_out_of_scope", "out_of_scope", "CALL this to end the call when the customer wanted something that is not an application or a status enquiry (a balance, a payment, a transfer, a complaint) and declined the transfer to the general team. The closing sentence is spoken for you."),
               510	    ("close_declined_identity", "declined", "CALL this to end the call when the customer still refuses the security questions after you explained once that they protect the account. The closing sentence is spoken for you."),
               511	    ("close_incomplete", "incomplete", "CALL this to end the call when a field could not be given in the right format after three tries and the customer declined the transfer to the applications team. The closing sentence is spoken for you."),
               512	    ("close_service_error", "service_error", "CALL this to end the call when create_application failed twice and the customer declined the transfer to the applications team. The closing sentence is spoken for you."),
               513	    ("close_done", "done", "CALL this to end the call when every request of the customer is handled and they want nothing more (also after an existing application was reported, or after a status was given, or the customer declined a transfer after hearing a status). The closing sentence is spoken for you."),
               514	]
               515	
               516	
               517	def exits():
               518	    out = [tr("compute_close", "A transfer went through", grp(*[c("xfer_queue", "equals", q) for q in ("applications", "security", "general")]))]
               519	    for node, _, desc in CLOSE_TOOLS:
               520	        out.append(tr(node, desc, {"operator": "matches_intent", "description": desc}, tool=True))
               521	    return out
