             """Generator for the statement-debt phone agent (Freya Bank, credit card statement debt, Turkish calls).
             
                 python out/gen_BRIEF.py <tool base url ending in /voice/v1>     writes out/BRIEF.workflow.json
                 python out/gen_BRIEF.py --selftest                              execs every hook on sample inputs
             
             Every rule, wording and value comes from the case folder (BRIEF.md and its sources): the 8 Oct analysis,
             the 9 Oct decisions mail (latest), the 7 Oct session, the 1 Oct service contract. Later records govern earlier ones.
             All bank calls are engine-run (pre_actions); the model never calls a tool.
             """
             import json, pathlib, sys
             
             OUT = pathlib.Path(__file__).resolve().parent / "BRIEF.workflow.json"
             
             # ---------------------------------------------------------------- fixed lines (verbatim from the sources)
             L_MENU = "Sizi ana menüye yönlendiriyorum."
             L_NO_CARD = "Ekstre borcunu sorgulayabileceğiniz uygun bir kredi kartınız bulunmuyor. Sizi ana menüye aktarıyorum."
             L_TRIES = "Size şu anda yardımcı olamıyorum. Sizi ana menüye aktarıyorum."
             L_MENU_AKT = "Sizi ana menüye aktarıyorum."
             L_SILENCE = "Sesinizi alamadığım için görüşmeyi sonlandırıyorum."
             L_AGENT = "Sizi müşteri temsilcimize aktarıyorum."
             L_PAY = "Borç ödeme işleminiz için sizi müşteri temsilcimize aktarıyorum."
             L_DISPUTE = "Bu konuda size müşteri temsilcimiz yardımcı olacak, sizi aktarıyorum."
             L_ERROR = "Şu anda işleminizi gerçekleştiremiyorum, sizi müşteri temsilcimize aktarıyorum."
             L_WEEK_ERROR = "Şu anda hesap kesim tarihinizi değiştiremiyorum, sizi müşteri temsilcimize aktarıyorum."
             L_OOS_Q = "Size bu konuda yardımcı olamıyorum. Sizi ana menüye aktarmamı ister misiniz?"
             L_SECURITY = ("Güvenlik nedeniyle yalnızca kendi kartlarınızla ilgili bilgi verebilir ve işlem yapabilirim. "
                           "Kart sahibinin kendi kimliğiyle giriş yapabilmesi için sizi ana menüye aktarıyorum.")
             L_NO_EMAIL = "Bankamızda kayıtlı bir e-posta adresiniz bulunmadığı için ekstrenizi gönderemiyorum."
             L_SENT = "Ekstreniz kayıtlı e-posta adresinize gönderildi."
             L_NOT_MINE = "Kayıtlı e-posta adresinizi bu görüşmede değiştiremiyorum. " + L_MENU
             L_PAPER = "Ekstrenizi posta ya da kısa mesajla gönderemiyorum; yalnızca son ekstrenizi kayıtlı e-posta adresinize gönderebiliyorum. " + L_MENU
             L_OTHER_CARD_Q = "Başka bir kartınızın borcunu öğrenmek ister misiniz?"
             
             # ---------------------------------------------------------------- shared code (no double braces anywhere)
             COMMON = r'''
             import re, json, datetime
             ONES = ['', 'bir', 'iki', 'üç', 'dört', 'beş', 'altı', 'yedi', 'sekiz', 'dokuz']
             TENS = ['', 'on', 'yirmi', 'otuz', 'kırk', 'elli', 'altmış', 'yetmiş', 'seksen', 'doksan']
             DIG = ['sıfır', 'bir', 'iki', 'üç', 'dört', 'beş', 'altı', 'yedi', 'sekiz', 'dokuz']
             MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık']
             CUR = [('TL', 'debtTL', 'Türk Lirası'), ('USD', 'debtUSD', 'Dolar'), ('EUR', 'debtEUR', 'Euro'), ('GBP', 'debtGBP', 'İngiliz Sterlini')]
             def w3(n):
                 p = []
                 h, r = n // 100, n % 100
                 if h:
                     p.append('yüz' if h == 1 else ONES[h] + ' yüz')
                 if r // 10:
                     p.append(TENS[r // 10])
                 if r % 10:
                     p.append(ONES[r % 10])
                 return ' '.join(p)
             def words(n):
                 n = int(n)
                 if n == 0:
                     return 'sıfır'
                 out = []
                 for val, name in ((10 ** 9, 'milyar'), (10 ** 6, 'milyon'), (1000, 'bin')):
                     g = n // val
                     n = n % val
                     if g:
                         if val == 1000 and g == 1:
                             out.append('bin')
                         else:
                             out.append(w3(g) + ' ' + name)
                 if n:
                     out.append(w3(n))
                 return ' '.join(out)
             def num(x):
                 try:
                     return float(x)
                 except Exception:
                     return 0.0
             def amount(x, cur):
                 v = abs(num(x))
                 cents = int(round(v * 100))
                 whole, frac = cents // 100, cents % 100
                 if cur == 'TL':
                     if frac == 0:
                         return words(whole) + ' Türk Lirası'
                     return (words(whole) + ' lira ' if whole else '') + words(frac) + ' kuruş'
                 if cur == 'USD':
                     if frac == 0:
                         return words(whole) + ' Dolar'
                     return (words(whole) + ' dolar ' if whole else '') + words(frac) + ' sent'
                 if cur == 'EUR':
                     if frac == 0:
                         return words(whole) + ' Euro'
                     return (words(whole) + ' euro ' if whole else '') + words(frac) + ' sent'
                 if frac == 0:
                     return words(whole) + ' İngiliz Sterlini'
                 return (words(whole) + ' sterlin ' if whole else '') + words(frac) + ' peni'
             def suffix(phrase, apos=True):
                 w = phrase.strip().split(' ')[-1]
                 low = w.replace('I', 'ı').replace('İ', 'i').lower()
                 vow = [ch for ch in low if ch in 'aeıioöuü']
                 lv = vow[-1] if vow else 'e'
                 v = dict(a='ı', ı='ı', e='i', i='i', o='u', u='u', ö='ü', ü='ü')[lv]
                 cons = 't' if low[-1] in 'çfhkpsşt' else 'd'
                 return phrase + ("'" if apos else '') + cons + v + 'r'
             def amt_dir(x, cur):
                 p = amount(x, cur)
                 last = p.split(' ')[-1]
                 return suffix(p, last[0].isupper())
             def pdate(s):
                 try:
                     d, m, y = str(s).strip().split('.')
                     return datetime.date(int(y), int(m), int(d))
                 except Exception:
                     return None
             def sdate(d):
                 return str(d.day) + ' ' + MONTHS[d.month - 1] + ' ' + str(d.year)
             def sdate_dir(d):
                 return sdate(d) + "'" + suffix(words(d.year), False)[len(words(d.year)):]
             def today():
                 try:
                     return datetime.date.fromisoformat(str(vars.get('now') or '')[:10])
                 except Exception:
                     return datetime.date.today()
             def digits_words(s):
                 return ' '.join(DIG[int(ch)] for ch in str(s) if ch.isdigit())
             def tlow(s):
                 return str(s or '').replace('I', 'ı').replace('İ', 'i').lower()
             def body_of(result):
                 if isinstance(result, dict):
                     result.pop('header', None)
                     d = result.get('data')
                     if isinstance(d, dict):
                         return d
                 return None
             def ok_of(b):
                 if not isinstance(b, dict):
                     return False
                 r = b.get('result')
                 return isinstance(r, dict) and str(r.get('returnCode')) == '1' and isinstance(b.get('data'), dict)
             def jl(name, dflt):
                 try:
                     v = json.loads(str(vars.get(name) or ''))
                     return v
                 except Exception:
                     return dflt
             def card_label(c):
                 n = str(c.get('productName') or '').strip()
                 if n:
                     return n
                 return 'sonu ' + digits_words(c.get('cardNumberLast4')) + ' ile biten kartınız'
             def join_tr(items, conj='veya'):
                 items = [i for i in items if i]
                 if len(items) <= 1:
                     return ''.join(items)
                 return ', '.join(items[:-1]) + ' ' + conj + ' ' + items[-1]
             def base_question(cards, exclude):
                 names = []
                 for i, c in enumerate(cards):
                     if i in exclude or not c.get('main'):
                         continue
                     n = str(c.get('productName') or '').strip()
                     if n and n not in names:
                         names.append(n)
                 q = 'Hangi kartınızın borcunu öğrenmek istersiniz?'
                 if len(names) >= 2:
                     q += ' Örneğin, ' + names[0] + ' veya ' + names[1] + ' diyebilirsiniz.'
                 elif len(names) == 1:
                     q += ' Örneğin, ' + names[0] + ' diyebilirsiniz.'
                 return q
             def all_names(cards):
                 names = []
                 for c in cards:
                     if not c.get('main'):
                         continue
                     n = card_label(c)
                     if n not in names:
                         names.append(n)
                 return names
