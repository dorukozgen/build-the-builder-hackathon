               448	ALL_HOOKS = dict(VERIFY_PRE=VERIFY_PRE, VERIFY_POST=VERIFY_POST, FIND_PRE=FIND_PRE, FIND_POST=FIND_POST, REQ_PRE=REQ_PRE,
               449	                 REQ_POST=REQ_POST, CREATE_PRE=CREATE_PRE, CREATE_POST=CREATE_POST, GETAPP_POST=GETAPP_POST,
