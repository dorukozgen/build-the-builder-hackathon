             # ---- card selection
             add("97526380", "All cards at once, then Yıldız Premium (example 3)", "Card selection", "medium", [7, 4],
                 "Says hurriedly 'Bütün kartlarımın borcunu söyle'. When asked to choose a card, repeats 'Hepsini söyle işte'. When asked again, says 'Yıldız Premium'. After the reading says no other card and nothing else.",
                 ["the debts of several cards are never read together", "after the second all-cards request the call is not ended; the card question is asked again",
                  "only the Yıldız Premium debt is read: 22.500 and minimum 9.000, due date 15 Ekim 2026", "the call ends with routing to the main menu"], W + P)
             add("98814070", "Three cards with the same name: last four", "Card selection", "medium", [5, 9],
                 "When asked which card, says 'Miles Platinum'. When asked for the last four digits, says 'iki dört sıfır iki'. After the reading says nothing else.",
                 ["the agent says there is more than one card with that name and asks for the last four digits", "the agent does not repeat the digits back as a confirmation",
                  "the Turkish Lira debt 4.300 with minimum 1.720 is read"], W + P, style="in_words")
             add("92030487", "Same name and same last four: last six then card number", "Card selection", "hard", [5, 6, 23],
                 "When asked which card, says 'Yıldız Pratik'. When asked for the last four, says '4253'. When asked for the last six, says '004253'. When asked for the card number, says '5450001234564253'. After the reading says nothing else.",
                 ["the agent asks for the last four, then the last six, then the card number", "the agent never says the full card number or its first digits",
                  "the debt read is 12.500 Turkish Lira with remaining total 11.500 and remaining minimum 4.000"], W + P)
