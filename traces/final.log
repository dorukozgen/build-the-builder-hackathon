             def norm(s):
                 s = str(s or '').replace('İ', 'i').replace('I', 'ı').lower()
                 s = s.replace('yildiz', 'yıldız')
                 return re.sub(r'\s+', ' ', re.sub(r'[^0-9a-zçğıöşü ]', ' ', s)).strip()
             NUMW = dict(sıfır=0, bir=1, iki=2, üç=3, dört=4, beş=5, altı=6, yedi=7, sekiz=8, dokuz=9)
             TENW = dict(on=10, yirmi=20, otuz=30, kırk=40, elli=50, altmış=60, yetmiş=70, seksen=80, doksan=90)
             def said_digits(s):
                 low = norm(s)
                 out = ''
                 toks = low.split()
                 i = 0
                 while i < len(toks):
                     t = toks[i]
                     if t.isdigit():
                         out += t
                     elif t in TENW:
                         v = TENW[t]
                         if i + 1 < len(toks) and toks[i + 1] in NUMW and NUMW[toks[i + 1]] > 0:
                             v += NUMW[toks[i + 1]]
