             """Generator for the Freya Bank statement-debt agent (final case folder FreyaBank-Ekstre-Borc).
             
                 python out/gen_freyabank_ekstre_borc.py <tool base url ending in /voice/v1>   writes out/freyabank-ekstre-borc.workflow.json
                 python out/gen_freyabank_ekstre_borc.py --selftest                            execs every code snippet on sample inputs
             
             Every rule, sentence and value comes from the case folder's sources (latest record governs) and the service contract.
             """
             import json, pathlib, sys
             
             OUT = pathlib.Path(__file__).resolve().parent / "freyabank-ekstre-borc.workflow.json"
             
             # ---------------------------------------------------------------- fixed sentences from the sources
             L_MENU = "Sizi ana menüye yönlendiriyorum."
             L_MENU_FAIL = "Size şu anda yardımcı olamıyorum. Sizi ana menüye aktarıyorum."
             L_NO_CARD = "Ekstre borcunu sorgulayabileceğiniz uygun bir kredi kartınız bulunmuyor. Sizi ana menüye aktarıyorum."
             L_AGENT = "Sizi müşteri temsilcimize aktarıyorum."
             L_PAY = "Borç ödeme işleminiz için sizi müşteri temsilcimize aktarıyorum."
             L_DISPUTE = "Bu konuda size müşteri temsilcimiz yardımcı olacak, sizi aktarıyorum."
             L_ERROR = "Şu anda işleminizi gerçekleştiremiyorum, sizi müşteri temsilcimize aktarıyorum."
             L_WEEK_ERROR = "Şu anda hesap kesim tarihinizi değiştiremiyorum, sizi müşteri temsilcimize aktarıyorum."
             L_LANG = "Sizi ana menüye aktarıyorum."
             L_OOS_Q = "Size bu konuda yardımcı olamıyorum. Sizi ana menüye aktarmamı ister misiniz?"
             L_SILENCE = "Sesinizi alamadığım için görüşmeyi sonlandırıyorum."
             L_THIRD = ("Güvenlik nedeniyle işlemleri yalnızca kendi kartlarınız için yapabiliyorum. "
                        "Kart sahibinin kendi kimliğiyle giriş yapabilmesi için sizi ana menüye yönlendiriyorum.")
             
             # ---------------------------------------------------------------- shared code (never double braces)
             COMMON = r'''
             import re, json, datetime
             from decimal import Decimal, ROUND_HALF_UP
             ONES = ['', 'bir', 'iki', 'üç', 'dört', 'beş', 'altı', 'yedi', 'sekiz', 'dokuz']
             TENS = ['', 'on', 'yirmi', 'otuz', 'kırk', 'elli', 'altmış', 'yetmiş', 'seksen', 'doksan']
             DIG = ['sıfır', 'bir', 'iki', 'üç', 'dört', 'beş', 'altı', 'yedi', 'sekiz', 'dokuz']
             MONTHS = ['Ocak', 'Şubat', 'Mart', 'Nisan', 'Mayıs', 'Haziran', 'Temmuz', 'Ağustos', 'Eylül', 'Ekim', 'Kasım', 'Aralık']
             CUR = [('debtTL', 'Türk Lirası'), ('debtUSD', 'Dolar'), ('debtEUR', 'Euro'), ('debtGBP', 'İngiliz Sterlini')]
             UNIT = dict(debtTL=('Türk Lirası', 'lira', 'kuruş'), debtUSD=('dolar', 'dolar', 'sent'), debtEUR=('Euro', 'Euro', 'sent'), debtGBP=('İngiliz Sterlini', 'İngiliz Sterlini', 'peni'))
             def w3(n):
                 h, t, o = n // 100, (n // 10) % 10, n % 10
                 out = []
                 if h:
                     out.append('yüz' if h == 1 else ONES[h] + ' yüz')
                 if t:
                     out.append(TENS[t])
                 if o:
                     out.append(ONES[o])
                 return ' '.join(out)
             def words(n):
                 n = int(n)
                 if n == 0:
                     return 'sıfır'
                 parts = []
                 for size, name in ((10 ** 9, 'milyar'), (10 ** 6, 'milyon'), (1000, 'bin')):
                     q = n // size
                     if q:
                         if size == 1000 and q == 1:
                             parts.append('bin')
                         else:
                             parts.append(w3(q) if q < 1000 else words(q))
                             parts.append(name)
                         n = n % size
                 if n:
                     parts.append(w3(n))
                 return ' '.join(p for p in parts if p)
             def dec(x):
                 try:
                     return Decimal(str(x)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
                 except Exception:
                     return Decimal('0')
             def money(x, key):
                 d = dec(x)
                 whole = int(d)
                 frac = int((d - whole) * 100)
                 full, unit, sub = UNIT[key]
                 if frac == 0:
                     return words(whole) + ' ' + full
                 return words(whole) + ' ' + unit + ' ' + words(frac) + ' ' + sub
             def cop(phrase):
                 p = str(phrase).rstrip()
                 low = p.lower()
                 vow = [ch for ch in low if ch in 'aeıioöuü']
                 v = vow[-1] if vow else 'e'
                 suf = dict(a='ı', ı='ı', e='i', i='i', o='u', u='u', ö='ü', ü='ü')[v]
                 d = 't' if low and low[-1] in 'fstkçşhp' else 'd'
                 sep = "'" if (p[-1:].isdigit()) else ''
                 return p + sep + d + suf + 'r'
             def num_last_word(n):
                 return words(n).split()[-1]
             def pdate(s):
                 s = str(s or '').strip()
