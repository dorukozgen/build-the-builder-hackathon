               392	        reason = dict(applications='applications', security='security', general='human').get(q, 'human')
               393	        team = dict(applications='applications team', security='security team', general='general team').get(q, 'team')
               394	        line = 'I am passing your call to our ' + team + ' now, and a colleague will take it from here.'
               395	    elif ids:
               396	        outcome = 'application_created'
               397	        line = 'Your application ' + ' and '.join(spell(i) for i in ids) + (' has' if len(ids) == 1 else ' have') + ' been received, not approved, and you will be informed within five business days by SMS.'
               398	    elif str(vars.get('status_given') or '') == 'yes':
               399	        outcome = 'status_given'
               400	        line = 'I have given you the current status of your application, and no new application was made on this call.'
               401	    elif idst == 'failed':
               402	        outcome, reason = 'not_verified', 'failed'
               403	        line = 'I could not verify your identity, so the application cannot be taken on this call; you can call back or visit a branch.'
               404	    elif na == 'declined':
               405	        outcome, reason = 'not_verified', 'declined'
               406	        line = 'Without the security questions I cannot take the application on this call; you can call back or visit a branch.'
               407	    else:
               408	        outcome = 'no_action'
               409	        if str(vars.get('service_error') or '') == 'yes' and na in ('', 'done'):
               410	            na = 'service_error'
               411	        reason = na if na in ('unsupported', 'incomplete', 'out_of_scope', 'service_error') else 'out_of_scope'
               412	        line = dict(unsupported='I could not take that application on this call, and nothing was submitted.',
               413	                    incomplete='The application was not submitted because the details could not be completed, so nothing was recorded.',
               414	                    out_of_scope='I could not help with that on this call, and nothing was changed on your account.',
               415	                    service_error='The application was not submitted because of a technical problem, so please call us again later.')[reason]
               416	    vars['close_outcome'] = outcome
               417	    if reason:
               418	        vars['close_reason'] = reason
               419	    vars['closing_line'] = line + thanks
               420	except Exception:
               421	    vars['close_outcome'] = 'no_action'
               422	    vars['close_reason'] = 'out_of_scope'
               423	    vars['closing_line'] = 'Thank you for calling Freya Bank. Goodbye.'
