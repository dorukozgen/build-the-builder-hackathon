                 if not m:
                     return None
                 try:
                     return datetime.date(int(m.group(3)), int(m.group(2)), int(m.group(1)))
                 except Exception:
                     return None
             def sdate(d):
                 return str(d.day) + ' ' + MONTHS[d.month - 1] + ' ' + str(d.year)
             def sdate_cop(d):
